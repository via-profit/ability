{
  "name": "@via-profit/ability",
  "support": "https://via-profit.ru",
  "version": "3.7.7",
  "description": "Lightweight ABAC engine with DSL, TypeScript types generation and zero dependencies",
  "homepage": "https://via-profit.github.io/ability/",
  "keywords": [
    "ability",
    "access",
    "access-control",
    "abac",
    "permissions",
    "policy",
    "dsl",
    "via-profit"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">= 17.0.0",
    "npm": ">= 8.19.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:dev": "cross-env NODE_ENV=development rollup -c -w",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "bench": "npm run build && node ./bench/benchmark.js",
    "test": "jest",
    "lint": "tsc --noEmit && eslint --fix .",
    "pretty": "prettier --write ./src",
    "website": "npm --prefix website start",
    "website:build": "npm --prefix website run build",
    "website:prod": "npm --prefix website run start:prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/via-profit/ability.git"
  },
  "author": {
    "name": "Via Profit",
    "url": "https://dev.via-profit.ru"
  },
  "contributors": [
    "Vasily Novosad <delhsmail@gmail.com>",
    "Pavel Natalin <trubonru@gmail.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-jest": "^29.15.1",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "tinybench": "^6.0.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  }
}
