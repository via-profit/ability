    "@codemirror/view": "^6.43.13",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@lezer/highlight": "^1.2.4",
    "@via-profit/ui-kit": "^0.13.0",
    "codemirror": "^6.0.2",
    "markdown-to-jsx": "^9.10.3",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
